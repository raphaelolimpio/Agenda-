PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require
# Opcional: no proxy público do Railway o certificado é autoassinado; por padrão,
# o backend mantém TLS e desabilita a validação apenas para esse host.
# Em outros bancos a validação permanece habilitada. Use false/true para sobrescrever.
DATABASE_SSL_REJECT_UNAUTHORIZED=
# Se o provedor fornecer CA raiz, cadastre-a aqui para validação do certificado.
DATABASE_SSL_CA=
GEMINI_API_KEY=

# URL pública da aplicação no Vercel; rewrites encaminham API/webhooks ao Railway.
APP_BASE_URL=http://localhost:3000
# Origem pública exata do Vercel, sem barra final; adicione preview apenas se necessário.
CORS_ORIGINS=
# Resend envia e-mails de recuperação; mantenha estas variáveis somente no Railway.
RESEND_API_KEY=
EMAIL_FROM=Agenda+ <noreply@seudominio.com>

# Mercado Pago: use credenciais de teste primeiro e configure o webhook
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
SUBSCRIPTION_AMOUNT_BRL=50
TRIAL_DAYS=7
