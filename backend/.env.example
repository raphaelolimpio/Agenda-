PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require
# Opcional: no proxy público do Railway o certificado é autoassinado; por padrão,
# o backend mantém TLS e desabilita a validação apenas para esse host.
# Em outros bancos a validação permanece habilitada. Use false/true para sobrescrever.
DATABASE_SSL_REJECT_UNAUTHORIZED=
# Se o provedor fornecer CA raiz, cadastre-a aqui para validação do certificado.
DATABASE_SSL_CA=
GEMINI_API_KEY=

# URL pública da aplicação no Vercel; rewrites encaminham API/webhooks ao Railway.
APP_BASE_URL=http://localhost:3000
# Origem pública exata do Vercel, sem barra final; adicione preview apenas se necessário.
CORS_ORIGINS=
# Meta WhatsApp Cloud API. Cadastre templates aprovados em pt_BR com:
# agenda_conta_criada (1 variável de corpo: nome) e agenda_recuperar_senha
# (2 variáveis de corpo: nome e link). Mantenha segredos somente no Railway.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_TEMPLATE_ACCOUNT_CREATED=agenda_conta_criada
WHATSAPP_TEMPLATE_PASSWORD_RESET=agenda_recuperar_senha
# Chave administrativa (mínimo 32 caracteres) para gerar links temporários via API.
PASSWORD_RESET_ADMIN_KEY=

# Mercado Pago: use credenciais de teste primeiro e configure o webhook
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
SUBSCRIPTION_AMOUNT_BRL=50
TRIAL_DAYS=7
